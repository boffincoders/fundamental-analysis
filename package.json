{
  "name": "finance-calculator-pro",
  "version": "1.2.1",
  "author": {
    "name": "Boffin Coders",
    "url": "https://boffincoders.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boffincoders/finance-calculator.git"
  },
  "bugs": {
    "url": "https://github.com/boffincoders/finance-calculator/issues"
  },
  "homepage": "https://boffincoders.github.io/finance-calculator/",
  "description": "Zero-dependency TypeScript library for fundamental financial analysis: valuation ratios (P/E, P/B, P/S, PEG, EV/EBITDA, EV/FCF), profitability (ROE, ROA, ROIC, margins), liquidity and leverage (current and quick ratio, net debt/EBITDA, interest coverage), efficiency (DSO, DPO, cash conversion cycle), Altman Z and Z'' scores, Piotroski F-Score, Sharpe ratio, DCF, Graham number, intrinsic value, CAGR and TTM helpers, with plain-English ratings. Works with any data source.",
  "keywords": [
    "finance",
    "financial-ratios",
    "financial-analysis",
    "financial-calculator",
    "financial-metrics",
    "valuation",
    "fundamental-analysis",
    "stock-analysis",
    "stock-screener",
    "investment-analysis",
    "equity-analysis",
    "pe-ratio",
    "price-to-earnings",
    "price-to-book",
    "price-to-sales",
    "ev-ebitda",
    "enterprise-value",
    "dcf",
    "discounted-cash-flow",
    "graham-number",
    "altman-z-score",
    "z-score",
    "piotroski",
    "piotroski-f-score",
    "sharpe-ratio",
    "roa",
    "roe",
    "roic",
    "profit-margin",
    "liquidity-ratio",
    "debt-to-equity",
    "solvency",
    "typescript",
    "zero-dependency",
    "cash-conversion-cycle",
    "ttm",
    "trailing-twelve-months",
    "intrinsic-value",
    "composite-scoring",
    "f-score"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
